<UserControl x:Class="HyperBoostX.App.IntegrationsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="{Binding IntegrationCredentialStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,15"/>
  <StackPanel Visibility="{Binding IsAiCenter,Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="{Binding Localization[AiSectionTitle]}" FontSize="20"/>
   <TextBlock Text="{Binding Localization[OnlineRequestsOptIn]}" Margin="0,8,0,12"/>
   <TextBlock Text="{Binding Localization[ProviderApiBaseUrl]}"/><TextBox Text="{Binding AiEndpoint,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localization[ProviderApiBaseUrl]}" Margin="0,4,0,12"/>
   <TextBlock Text="{Binding Localization[NewApiKey]}"/><PasswordBox x:Name="AiKeyBox" MaxLength="8192" Padding="10" Margin="0,4,0,10" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="{Binding Localization[NewApiKey]}"/>
   <WrapPanel Margin="0,0,0,12"><Button Content="{Binding Localization[SaveKeyLocally]}" Click="SaveAiKey" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}"/><Button Content="{Binding Localization[RemoveSavedKey]}" Command="{Binding ClearAiSecretCommand}"/></WrapPanel>
   <TextBlock Text="{Binding Localization[ModelCatalogFilter]}"/><TextBox Text="{Binding AiModelFilter,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
   <WrapPanel Margin="0,0,0,10"><Button Content="{Binding Localization[DiscoverProviderModels]}" Command="{Binding DiscoverModelsCommand}"/><Button Content="{Binding Localization[TestSelectedModel]}" Command="{Binding TestAiCommand}"/></WrapPanel>
   <ComboBox ItemsSource="{Binding AiModels}" SelectedItem="{Binding SelectedAiModel}" AutomationProperties.Name="{Binding Localization[DiscoveredAiModels]}" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding Localization[QuestionMostRecentReport]}"/><TextBox Text="{Binding AiQuestion,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxLength="4000" Margin="0,4,0,12"/>
   <WrapPanel Margin="0,0,0,12"><Button Content="{Binding Localization[PreviewSendReport]}" Command="{Binding AskAiCommand}"/><Button Content="{Binding Localization[AnalyzeOffline]}" Command="{Binding OfflineAdviceCommand}"/></WrapPanel>
   <TextBox Text="{Binding AiResult,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="300" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Localization[AiAdvice]}"/>
   <ComboBox ItemsSource="{Binding AiSuggestedActions}" SelectedItem="{Binding SelectedAiAction}" DisplayMemberPath="Name" Margin="0,12" AutomationProperties.Name="{Binding Localization[ValidatedActionSuggestions]}"/>
   <Button Content="{Binding Localization[ReviewSuggestedAction]}" Command="{Binding ReviewAiActionCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
  </StackPanel>
  <StackPanel Visibility="{Binding IsNotifications,Converter={StaticResource BoolVisibility}}">
   <TextBlock Text="{Binding Localization[DiscordNotifications]}" FontSize="20"/>
   <TextBlock Text="{Binding Localization[DiscordDataDisclosure]}" Margin="0,8,0,12"/>
   <TextBlock Text="{Binding Localization[NewDiscordWebhookUrl]}"/><PasswordBox x:Name="WebhookBox" MaxLength="2048" Padding="10" Margin="0,4,0,12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="{Binding Localization[NewDiscordWebhookUrl]}"/>
   <WrapPanel Margin="0,0,0,12"><Button Content="{Binding Localization[SaveWebhookLocally]}" Click="SaveWebhook" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}"/><Button Content="{Binding Localization[RemoveWebhook]}" Command="{Binding ClearWebhookCommand}"/></WrapPanel>
   <CheckBox Content="{Binding Localization[EnableErrorMetadataDelivery]}" IsChecked="{Binding WebhookEnabled}" IsEnabled="{Binding CanToggleWebhook}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,12"/>
   <Button Content="{Binding Localization[SendConnectionTest]}" Command="{Binding TestWebhookCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
   <DataGrid ItemsSource="{Binding NotificationHistory}" Height="280" AutomationProperties.Name="{Binding Localization[NotificationHistory]}"><DataGrid.Columns><DataGridTextColumn Header="{Binding Localization[Time]}" Binding="{Binding CreatedAt}" Width="160"/><DataGridTextColumn Header="{Binding Localization[Category]}" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="{Binding Localization[Code]}" Binding="{Binding Code}" Width="140"/><DataGridTextColumn Header="{Binding Localization[Delivery]}" Binding="{Binding Delivery}" Width="*"/></DataGrid.Columns></DataGrid>
  </StackPanel>
 </StackPanel>
</UserControl>
