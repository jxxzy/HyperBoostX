{
  "SchemaVersion": 1,
  "ActionRegistryVersion": 1,
  "Actions": [
    {
      "Id": "windows.visual.transparency.disable",
      "Name": "Disable transparency",
      "Center": "Optimize",
      "Description": "Turn off Windows transparency. This changes appearance; an FPS gain is not promised.",
      "Scope": "Current user",
      "Risk": "Low \u00B7 reversible",
      "Restart": "Sign out or restart affected app if needed",
      "Source": "Windows HKCU Registry",
      "Reversible": true
    },
    {
      "Id": "windows.visual.transparency.enable",
      "Name": "Enable transparency",
      "Center": "Optimize",
      "Description": "Enable Windows transparency for this user.",
      "Scope": "Current user",
      "Risk": "Low \u00B7 reversible",
      "Restart": "Sign out or restart affected app if needed",
      "Source": "Windows HKCU Registry",
      "Reversible": true
    },
    {
      "Id": "windows.visual.effects.best_performance",
      "Name": "Set visual effects to best performance",
      "Center": "Optimize",
      "Description": "Set the existing current-user Windows visual-effects preset to best performance. This changes appearance and may reduce animation or visual effects; review accessibility preferences. No FPS gain is promised.",
      "Scope": "Current user",
      "Risk": "Medium \u00B7 reversible",
      "Restart": "Sign out or restart affected apps",
      "Source": "Windows HKCU VisualFXSetting",
      "Reversible": true
    },
    {
      "Id": "gaming.capture.disable",
      "Name": "Disable game capture preference",
      "Center": "Gaming",
      "Description": "Disable the current user\u0027s game capture preference. Other capture applications remain independent. Restart the game to evaluate behavior.",
      "Scope": "Current user",
      "Risk": "Low \u00B7 reversible",
      "Restart": "Sign out or restart affected app if needed",
      "Source": "Windows HKCU Registry",
      "Reversible": true
    },
    {
      "Id": "gaming.capture.enable",
      "Name": "Enable game capture preference",
      "Center": "Gaming",
      "Description": "Enable the current user\u0027s Windows game capture preference.",
      "Scope": "Current user",
      "Risk": "Low \u00B7 reversible",
      "Restart": "Sign out or restart affected app if needed",
      "Source": "Windows HKCU Registry",
      "Reversible": true
    },
    {
      "Id": "windows.power.set_plan",
      "Name": "Set active power plan",
      "Center": "Power",
      "Description": "Select an existing Windows power plan. Higher performance plans can increase heat and battery use. OEM software may override this setting.",
      "Scope": "Current user / PC power policy",
      "Risk": "Medium \u00B7 reversible",
      "Restart": "No restart",
      "Source": "PowrProf API",
      "Reversible": true
    },
    {
      "Id": "startup.current_user.disable",
      "Name": "Disable selected startup entry",
      "Center": "Startup",
      "Description": "Remove the selected HKCU Run value after backing up its exact command and type. Restore is blocked if another program recreates it differently.",
      "Scope": "Current user",
      "Risk": "Medium \u00B7 reversible",
      "Restart": "Next sign-in",
      "Source": "HKCU Run",
      "Reversible": true
    },
    {
      "Id": "storage.temp.quarantine",
      "Name": "Quarantine selected old temporary file",
      "Center": "Cleanup",
      "Description": "Move one selected .tmp file older than 7 days into local recovery quarantine. Contents are preserved, not erased. Restore verifies SHA-256 and never overwrites a new file. Quarantine does not reclaim disk space until separately managed.",
      "Scope": "Current user's temporary folder",
      "Risk": "Moderate \u00B7 reversible",
      "Restart": "None",
      "Source": "Native filesystem + SHA-256",
      "Reversible": true
    },
    {
      "Id": "network.dns.set_profile",
      "Name": "Set adapter DNS profile",
      "Center": "Network",
      "Description": "Set an explicitly selected adapter to automatic DNS or a compiled public-resolver preset. This does not promise lower latency and may affect name resolution.",
      "Scope": "Selected PC network adapter",
      "Risk": "Medium \u00B7 reversible",
      "Restart": "Reconnect the adapter if applications retain cached results",
      "Source": "Win32_NetworkAdapterConfiguration WMI",
      "Reversible": true,
      "RequiresElevation": true
    },
    {
      "Id": "gaming.process.priority.above_normal",
      "Name": "Set game process priority to AboveNormal",
      "Center": "Gaming",
      "Description": "Raise only the selected, registered game process from Normal or BelowNormal to AboveNormal for this session. This does not promise higher FPS; the original priority is journaled and restored when the session ends.",
      "Scope": "Selected game process in the current Windows session",
      "Risk": "Moderate · reversible",
      "Restart": "Restore when the game session ends",
      "Source": "Windows Process API",
      "Reversible": true
    }
  ],
