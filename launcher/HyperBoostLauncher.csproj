<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\wpf\Assets\HyperBoostX.ico</ApplicationIcon>
    <AssemblyTitle>HyperBoost X Launcher</AssemblyTitle>
    <AssemblyDescription>One-click launcher for HyperBoost X</AssemblyDescription>
    <AssemblyCompany>HyperBoost</AssemblyCompany>
    <AssemblyProduct>HyperBoost X</AssemblyProduct>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

</Project>
