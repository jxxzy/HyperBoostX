<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CyberCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}"/>
    </Style>

    <Style x:Key="CyberHeroCardStyle" TargetType="Border" BasedOn="{StaticResource CyberCardStyle}">
        <Setter Property="Background" Value="{StaticResource Brush.Gradient.Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Glow}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="CyberTopLineCardStyle" TargetType="Border" BasedOn="{StaticResource CyberCardStyle}">
        <Setter Property="Padding" Value="0"/>
    </Style>
</ResourceDictionary>
