<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CyberBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#18243A"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="SuccessBadgeStyle" TargetType="Border" BasedOn="{StaticResource CyberBadgeStyle}">
        <Setter Property="Background" Value="#102E28"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Success}"/>
    </Style>

    <Style x:Key="WarningBadgeStyle" TargetType="Border" BasedOn="{StaticResource CyberBadgeStyle}">
        <Setter Property="Background" Value="#332611"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Warning}"/>
    </Style>

    <Style x:Key="DangerBadgeStyle" TargetType="Border" BasedOn="{StaticResource CyberBadgeStyle}">
        <Setter Property="Background" Value="#351520"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Status.Danger}"/>
    </Style>
</ResourceDictionary>
