<UserControl x:Class="HyperBoostX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HyperBoostX.ViewModels"
             AutomationProperties.AutomationId="CoreFeaturePage_Settings"
             Tag="CORE_UI:Settings"
             Loaded="SettingsView_Loaded">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,28">
            <Border Style="{StaticResource CyberHeroCardStyle}" Margin="0,0,0,18" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="34" FontWeight="Black"/>
                        <TextBlock Text="Theme, mode, Safety Guard, backend connection, privacy, reports, and update preferences." FontSize="14" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="860"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="250" Margin="22,0,0,0">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="Telemetry OFF by default" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}">
                            <TextBlock Text="Local data only" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,18">
                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="General" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Stable unsigned desktop runtime with local-first defaults." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <UniformGrid Columns="2">
                            <Border Background="#0F1B2B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Small}" Padding="12" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Version" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="2.10.0" FontSize="22" FontWeight="Black"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0F1B2B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Small}" Padding="12" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="Release Channel" Foreground="{StaticResource Brush.Text.Muted}"/>
                                    <TextBlock Text="Stable Unsigned" FontSize="22" FontWeight="Black"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Default Landing Page" FontWeight="Bold" Margin="0,8,0,8"/>
                        <ComboBox Style="{StaticResource CyberComboBoxStyle}" MinHeight="40" SelectedIndex="0">
                            <ComboBoxItem Content="Dashboard"/>
                            <ComboBoxItem Content="One Click Boost"/>
                            <ComboBoxItem Content="Restore &amp; Backup"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Appearance" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Keep the premium dark interface readable and reduce noisy effects when needed." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <TextBlock Text="Theme" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource CyberComboBoxStyle}" MinHeight="40" SelectedIndex="0" Margin="0,0,0,14">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="System"/>
                            <ComboBoxItem Content="Light (planned)"/>
                        </ComboBox>
                        <TextBlock Text="Accent Color" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource CyberComboBoxStyle}" SelectedValue="{Binding AccentColor, Mode=TwoWay}" SelectedValuePath="Content" MinHeight="40">
                            <ComboBoxItem Content="Cyan"/>
                            <ComboBoxItem Content="Purple"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Matrix Green"/>
                            <ComboBoxItem Content="Red Alert"/>
                            <ComboBoxItem Content="OLED Dark"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Motion &amp; Accessibility" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Reduce Motion disables scanner and pulse-heavy effects where supported." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <CheckBox Content="Enable animations" IsChecked="{Binding EnableAnimations, Mode=TwoWay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Clean premium mode" IsChecked="True" Foreground="{StaticResource Brush.Text.Primary}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Larger text mode" Foreground="{StaticResource Brush.Text.Primary}" FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Experience Mode" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Beginner shows safe core tools. Advanced adds more guarded controls. Expert exposes all menus and technical diagnostics without bypassing Safety Guard." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <ComboBox Style="{StaticResource CyberComboBoxStyle}" SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValuePath="Content" MinHeight="40">
                            <ComboBoxItem Content="Beginner"/>
                            <ComboBoxItem Content="Advanced"/>
                            <ComboBoxItem Content="Expert"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Safety Guard" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Safety Guard is always active. Expert mode cannot bypass blocked action categories." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,8,8"><TextBlock Text="Preview before apply" Foreground="{StaticResource Brush.Status.Success}"/></Border>
                            <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,8,8"><TextBlock Text="Confirmation required" Foreground="{StaticResource Brush.Status.Success}"/></Border>
                            <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,8,8"><TextBlock Text="Restore metadata required" Foreground="{StaticResource Brush.Status.Success}"/></Border>
                            <Border Style="{StaticResource WarningBadgeStyle}" Margin="0,0,8,8"><TextBlock Text="Destructive actions blocked" Foreground="{StaticResource Brush.Status.Warning}"/></Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Backend &amp; Local Engine" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="WPF connects to the local Python backend through the launcher session token." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,8,8"><TextBlock Text="Local API: 127.0.0.1" Foreground="{StaticResource Brush.Text.Secondary}"/></Border>
                            <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,8,8"><TextBlock Text="Session token: launcher managed" Foreground="{StaticResource Brush.Text.Secondary}"/></Border>
                        </UniformGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Refresh Connection" Click="ReloadSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Open Diagnostics" Click="OpenDiagnostics_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Privacy &amp; Local Data" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Reports, logs, and settings are local-first. Telemetry is off by default." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Open Local Data Folder" Click="OpenLocalData_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Export Privacy Report" Click="ExportSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,8,0,0">
                            <TextBlock Text="Tokens, API keys, and sensitive paths are redacted from reports where supported." Foreground="{StaticResource Brush.Status.Success}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Reports &amp; History" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Reports, action history, and restore history stay visible for review and support." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Export Settings" Click="ExportSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Import Settings" Click="ImportSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Reset Settings" Click="ResetSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Updates" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Current build is stable unsigned. The installer is not claimed as signed." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Open GitHub Release" Click="OpenGitHubRelease_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Copy Version Info" Click="CopyVersionInfo_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Save Changes" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Changes that affect navigation mode may require sidebar reload or relaunch depending on the active shell state." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Save Settings" Click="SaveSettings_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Reload" Click="ReloadSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource CyberCardStyle}">
                <Expander Header="Advanced Details" Foreground="{StaticResource Brush.Text.Primary}" IsExpanded="False">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Settings path: %LocalAppData%\HyperBoost X\ui_settings.json" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        <TextBlock Text="Backend config, raw settings JSON, and debug state are kept here instead of the main beginner UI." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
