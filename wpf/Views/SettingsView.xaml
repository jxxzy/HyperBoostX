<UserControl x:Class="HyperBoostX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HyperBoostX.ViewModels"
             Loaded="SettingsView_Loaded">
    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,28">
            <Border Style="{StaticResource CyberHeroCardStyle}" Margin="0,0,0,18" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="34" FontWeight="Black"/>
                        <TextBlock Text="Theme, motion, beginner mode, expert preview, and privacy-first UI preferences." FontSize="14" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="820"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="250" Margin="22,0,0,0">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="Telemetry OFF by default" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}">
                            <TextBlock Text="Stored in LocalAppData" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Motion" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Reduce Motion keeps the interface readable and disables scanner/pulse-heavy effects where supported." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <CheckBox Content="Enable Animations" IsChecked="{Binding EnableAnimations, Mode=TwoWay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox Content="Reduce Motion" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="14" Margin="0,0,0,18"/>

                        <TextBlock Text="Accent Color" FontWeight="Bold" Margin="0,8,0,8"/>
                        <ComboBox SelectedValue="{Binding AccentColor, Mode=TwoWay}" SelectedValuePath="Content" MinHeight="40" Foreground="{StaticResource Brush.Text.Primary}" Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}">
                            <ComboBoxItem Content="Cyan"/>
                            <ComboBoxItem Content="Purple"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Matrix Green"/>
                            <ComboBoxItem Content="Red Alert"/>
                            <ComboBoxItem Content="OLED Dark"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CyberCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Experience Mode" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Beginner keeps copy explicit and safe. Expert Preview exposes future/experimental cards without enabling dangerous actions." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,18"/>
                        <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValuePath="Content" MinHeight="40" Foreground="{StaticResource Brush.Text.Primary}" Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}">
                            <ComboBoxItem Content="Beginner"/>
                            <ComboBoxItem Content="Advanced"/>
                            <ComboBoxItem Content="Expert Preview"/>
                        </ComboBox>

                        <WrapPanel Margin="0,22,0,0">
                            <Button Content="Save Settings" Click="SaveSettings_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Reload" Click="ReloadSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>

                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
