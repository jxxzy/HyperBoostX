<UserControl x:Class="HyperBoostX.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HyperBoostX.ViewModels"
             Loaded="DashboardView_Loaded">
    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,28">
            <Border Style="{StaticResource CyberHeroCardStyle}" Margin="0,0,0,18" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="HyperBoostX" FontSize="36" FontWeight="Black" Foreground="{StaticResource Brush.Text.Primary}"/>
                        <TextBlock Text="Safe AI Windows Gaming Optimizer" FontSize="17" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,4,0,0"/>
                        <TextBlock Text="Local-first scan, safe plan, report, and restore. HyperBoostX shows live evidence separately from Smart Scan recommendations." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,10,0,18" TextWrapping="Wrap" MaxWidth="760"/>
                        <WrapPanel>
                            <Button x:Name="StartSmartScanButton" Content="Start Smart Scan" Click="StartSmartScan_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button x:Name="OneClickSafeBoostButton" Content="One Click Safe Boost" Click="OneClickSafeBoost_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button x:Name="RestoreChangesButton" Content="Restore / Undo" Click="RestoreChanges_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="230" Margin="22,0,0,0">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="Safety Guard Active" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="Restore Available" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="{Binding ActiveGpu, StringFormat=GPU: {0}}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}">
                            <TextBlock Text="{Binding BackendStatus, StringFormat=Backend: {0}}" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Live Hardware Snapshot" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Live backend metrics can be available before Smart Scan. Recommendations and before/after analysis still require Smart Scan." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <ItemsControl ItemsSource="{Binding SystemMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F1B2B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Small}" Padding="14" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,8,0,2"/>
                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Black" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" MinHeight="38"/>
                                        <ProgressBar Value="{Binding Score}" Maximum="100" Style="{StaticResource CyberProgressBarStyle}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Smart Scan Results" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Smart Scan has not run yet. Live hardware snapshot is available, but recommendations and before/after analysis require Smart Scan." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
            <ItemsControl ItemsSource="{Binding Scores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0F1B2B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Small}" Padding="14" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Black" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                                <ProgressBar Value="{Binding Score}" Maximum="100" Style="{StaticResource CyberProgressBarStyle}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,0" MinHeight="260">
                    <StackPanel>
                        <TextBlock Text="Recommendations Preview" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Run Smart Scan to collect local pressure evidence and produce a safe plan. No synthetic chart or guaranteed FPS claim is shown before scan data exists." Foreground="{StaticResource Brush.Text.Muted}" Margin="0,3,0,18" TextWrapping="Wrap"/>
                        <Border Background="#0B1220" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource CornerRadius.Small}" Padding="18" MinHeight="150">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Smart Scan not run yet" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Live hardware snapshot is separate. Start Smart Scan to populate recommendations, report, and before/after history." Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button Content="Start Smart Scan" Click="StartSmartScan_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Content="Refresh Status" Click="RefreshStatus_Click" Style="{StaticResource CyberGhostButtonStyle}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CyberCardStyle}" MinHeight="260">
                    <StackPanel>
                        <TextBlock Text="AI Recommendation" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AiRecommendation}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,12,0,18" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource WarningBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="No guaranteed FPS claim" Foreground="{StaticResource Brush.Status.Warning}"/>
                        </Border>
                        <Border Style="{StaticResource SuccessBadgeStyle}">
                            <TextBlock Text="All risky actions blocked" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CyberCardStyle}">
                <StackPanel>
                    <TextBlock Text="Activity &amp; Shortcuts" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="User-facing shortcuts stay separate from release and audit tools. Expert mode keeps developer gates elsewhere." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                    <WrapPanel>
                        <Button x:Name="AutoGamingModeButton" Content="Gaming Mode" Click="AutoGamingMode_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        <Button x:Name="ViewLastReportButton" Content="View Last Report" Click="ViewLastReport_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        <Button x:Name="RefreshStatusButton" Content="Refresh Snapshot" Click="RefreshStatus_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        <Button x:Name="OpenBoostPlanButton" Content="Open Boost Plan" Click="OpenBoostPlan_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        <Button x:Name="ExportDashboardReportButton" Content="Export Report" Click="ExportDashboardReport_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        <Button x:Name="OpenSettingsButton" Content="Settings" Click="OpenSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        <Button x:Name="ViewPerformanceHistoryButton" Content="History" Click="ViewPerformanceHistory_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
