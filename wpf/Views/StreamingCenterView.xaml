<UserControl x:Class="HyperBoostX.Views.StreamingCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HyperBoostX.ViewModels">
    <UserControl.DataContext>
        <vm:StreamingCenterViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,28">
            <Border Style="{StaticResource CyberHeroCardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Streaming Center" FontSize="31" FontWeight="Black"/>
                        <TextBlock Text="Streaming tools for OBS, Discord, microphone, webcam, and virtual audio." Foreground="{StaticResource Brush.Accent.Primary}" FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="820"/>
                        <WrapPanel Margin="0,20,0,0">
                            <Button Content="Check Streaming" Click="CheckStreaming_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,12,8"/>
                            <Button Content="Export Streaming Profile" Click="ExportStreamingProfile_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,12,8"/>
                            <Button Content="Open Sound Settings" Click="OpenSoundSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,12,8"/>
                            <Button Content="Volume Mixer" Click="OpenVolumeMixer_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,12,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="250" Margin="22,0,0,0">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="OBS / Discord Protected" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource WarningBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="DSP controls are guidance" Foreground="{StaticResource Brush.Status.Warning}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}">
                            <TextBlock Text="No driver service changes" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Streaming Toolkit" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Preview-first tools for mic, virtual audio, webcam, and creator streaming profiles." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SuccessBadgeStyle}" Margin="12,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="Tools ready" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="2">
                        <Border Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Streaming" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="OBS/TikTok/Discord profile" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Start Streaming Optimization / Refresh Detect / Restore After Streaming" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Profile output keeps OBS, TikTok LIVE Studio, and Discord guidance visible while protected apps stay safe." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Mic" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Voice Meter / Voicemeeter / volume mixer" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Gain, gate, compressor, Windows sound settings, and Voicemeeter detection stay manual and driver-safe." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Webcam" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="Camera presets and diagnostics" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Brightness, contrast, sharpness, exposure, FPS target, black preview help, and privacy shortcuts are restored." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Safety" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="No hidden capture or driver rewiring" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="All streaming actions are visible, reversible guidance or explicit Windows settings handoffs." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Microphone &amp; Voice Meter" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Detect microphone devices, review default communications mic, preview gain/gate/compressor settings, and keep endpoint changes approval-first." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Refresh Microphones" Click="RefreshMicrophones_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Mic Diagnostics" Click="MicDiagnostics_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Mic Privacy" Click="OpenMicPrivacy_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Gain" Grid.Row="0" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="MicGainSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="55" ValueChanged="MicProfile_ValueChanged"/>
                            <TextBlock Text="Noise gate" Grid.Row="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="MicGateSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="28" ValueChanged="MicProfile_ValueChanged"/>
                            <TextBlock Text="Compressor" Grid.Row="2" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="MicCompressorSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="35" ValueChanged="MicProfile_ValueChanged"/>
                        </Grid>
                        <TextBlock x:Name="MicStatusText" Text="Preview Only: gain 55 | gate 28 | compressor 35. Endpoint changes require approved action support." Foreground="{StaticResource Brush.Text.Secondary}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CyberCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Voicemeeter / Virtual Audio" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Detect, launch if installed, or open the official download page. HyperBoostX does not silently install or rewire virtual audio." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Detect Voicemeeter" Click="DetectVoicemeeter_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Open Voicemeeter" Click="OpenVoicemeeter_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Official Download" Click="OpenVoicemeeterDownload_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,8,0,10">
                            <TextBlock x:Name="VoicemeeterStatusText" Text="Voicemeeter status: not checked" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Webcam Studio" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Camera diagnostics, Windows camera shortcuts, and profile output for OBS, TikTok LIVE Studio, and Discord. Presets are guidance and do not force driver writes." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Streaming Preset" Click="ApplyStreamingCameraPreset_Click" Style="{StaticResource CyberButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Low Light Preset" Click="ApplyLowLightCameraPreset_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Sharp Face Preset" Click="ApplySharpFaceCameraPreset_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Reset Profile" Click="ResetCameraProfile_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Scan Cameras" Click="ScanCameras_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Camera Diagnostics" Click="CameraDiagnostics_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Brightness" Grid.Row="0" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="CameraBrightnessSlider" Grid.Row="0" Grid.Column="1" Minimum="-50" Maximum="50" Value="8" ValueChanged="CameraProfile_ValueChanged"/>
                            <TextBlock Text="Contrast" Grid.Row="1" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="CameraContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="50" Value="12" ValueChanged="CameraProfile_ValueChanged"/>
                            <TextBlock Text="Sharpness" Grid.Row="2" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="CameraSharpnessSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="35" ValueChanged="CameraProfile_ValueChanged"/>
                            <TextBlock Text="Exposure" Grid.Row="3" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="CameraExposureSlider" Grid.Row="3" Grid.Column="1" Minimum="-3" Maximum="3" Value="0" ValueChanged="CameraProfile_ValueChanged"/>
                            <TextBlock Text="FPS target" Grid.Row="4" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,14,10"/>
                            <Slider x:Name="CameraFpsSlider" Grid.Row="4" Grid.Column="1" Minimum="24" Maximum="60" Value="30" ValueChanged="CameraProfile_ValueChanged"/>
                        </Grid>
                        <TextBlock x:Name="CameraStatusText" Text="Preview Only: brightness +8 | contrast +12 | sharpness 35 | exposure 0.0 EV | target 30 FPS." Foreground="{StaticResource Brush.Text.Secondary}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CyberCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Camera Profile &amp; Shortcuts" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Quick access to Windows camera controls plus profile text for OBS, TikTok LIVE Studio, Discord, and Creator Mode." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                        <WrapPanel>
                            <Button Content="Camera Settings" Click="OpenCameraSettings_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Camera Privacy" Click="OpenCameraPrivacy_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Open Camera App" Click="OpenCameraApp_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                            <Button Content="Device Manager" Click="OpenDeviceManager_Click" Style="{StaticResource CyberGhostButtonStyle}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <TextBlock x:Name="StreamingProfileText" Text="Profile output: OBS/TikTok/Discord recommendations will appear here after export." Foreground="{StaticResource Brush.Text.Secondary}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
