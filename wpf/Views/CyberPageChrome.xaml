<UserControl x:Class="HyperBoostX.Views.CyberPageChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,28">
            <Border Style="{StaticResource CyberHeroCardStyle}" Margin="0,0,0,18" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="31" FontWeight="Black" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="14" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="820"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Width="250" Margin="22,0,0,0">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="Safety Guard Active" FontWeight="SemiBold" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,0,10">
                            <TextBlock Text="Restore Visible" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}">
                            <TextBlock Text="Session-token aware" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,22,0,0">
                        <Button Content="Refresh Backend Status" Style="{StaticResource CyberButtonStyle}" Click="RefreshBackendStatus_Click" Margin="0,0,12,8"/>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,12,8">
                            <TextBlock Text="{Binding PrimaryAction, StringFormat=Primary flow: {0}}" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,12,8">
                            <TextBlock Text="{Binding Status, StringFormat=Status: {0}}" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </WrapPanel>

                    <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="2" Width="420" Fill="{StaticResource Brush.Gradient.CardTop}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Opacity="0.75">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-420"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource ScannerLineStoryboard}"/>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CyberCardStyle}" Margin="0,0,14,0" MinHeight="260">
                    <StackPanel>
                        <TextBlock Text="Live Capability Matrix" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Cyber UI exposes only safe, reviewable flows; mutating actions stay behind Safety Guard and session-token checks." Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,16"/>
                        <ItemsControl ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121A2D" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Glyph}" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Black"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Black" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                            <ProgressBar Value="{Binding Score}" Maximum="100" Style="{StaticResource CyberProgressBarStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CyberCardStyle}" MinHeight="260">
                    <StackPanel>
                        <TextBlock Text="AI Safety Notes" FontSize="17" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding Recommendations}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10192B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource WarningBadgeStyle}" Margin="0,8,0,10">
                            <TextBlock Text="No guaranteed FPS or ping claims" Foreground="{StaticResource Brush.Status.Warning}"/>
                        </Border>
                        <Border Style="{StaticResource SuccessBadgeStyle}">
                            <TextBlock Text="Read-only refresh is safe offline" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
