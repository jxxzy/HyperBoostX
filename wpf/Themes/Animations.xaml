<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Duration x:Key="Animation.Fast">0:0:0.14</Duration>
    <Duration x:Key="Animation.Normal">0:0:0.28</Duration>
    <Duration x:Key="Animation.Slow">0:0:0.8</Duration>

    <Storyboard x:Key="CyberPageEnterStoryboard">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.26"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="18" To="0" Duration="0:0:0.26">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="CyberPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.9"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.86" To="1.08" Duration="0:0:0.9"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.86" To="1.08" Duration="0:0:0.9"/>
    </Storyboard>

    <Storyboard x:Key="ScannerLineStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-420" To="900" Duration="0:0:3.2"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.7" Duration="0:0:0.35" AutoReverse="True"/>
    </Storyboard>

    <Storyboard x:Key="LoadingShimmerStoryboard" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-260" To="420" Duration="0:0:1.6"/>
    </Storyboard>
</ResourceDictionary>
