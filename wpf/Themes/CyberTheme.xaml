<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background.Main">#070913</Color>
    <Color x:Key="Color.Background.Sidebar">#0B0D18</Color>
    <Color x:Key="Color.Background.Panel">#111328</Color>
    <Color x:Key="Color.Surface.Card">#1A1230</Color>
    <Color x:Key="Color.Surface.CardHover">#261946</Color>
    <Color x:Key="Color.Surface.Modal">#121626</Color>
    <Color x:Key="Color.Accent.Primary">#22D3EE</Color>
    <Color x:Key="Color.Accent.Secondary">#C026D3</Color>
    <Color x:Key="Color.Accent.Tertiary">#7C3AED</Color>
    <Color x:Key="Color.Status.Success">#10B981</Color>
    <Color x:Key="Color.Status.Warning">#F59E0B</Color>
    <Color x:Key="Color.Status.Danger">#F43F5E</Color>
    <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
    <Color x:Key="Color.Text.Secondary">#C7D2FE</Color>
    <Color x:Key="Color.Text.Muted">#8B9AB5</Color>
    <Color x:Key="Color.Border.Glow">#7DD3FC</Color>
    <Color x:Key="Color.Border.Subtle">#2E3352</Color>

    <SolidColorBrush x:Key="Brush.Background.Main" Color="{StaticResource Color.Background.Main}"/>
    <SolidColorBrush x:Key="Brush.Background.Sidebar" Color="{StaticResource Color.Background.Sidebar}"/>
    <SolidColorBrush x:Key="Brush.Background.Panel" Color="{StaticResource Color.Background.Panel}"/>
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" Opacity="0.88"/>
    <SolidColorBrush x:Key="Brush.Surface.CardHover" Color="{StaticResource Color.Surface.CardHover}"/>
    <SolidColorBrush x:Key="Brush.Surface.Modal" Color="{StaticResource Color.Surface.Modal}"/>
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Secondary" Color="{StaticResource Color.Accent.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Tertiary" Color="{StaticResource Color.Accent.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}"/>
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}"/>
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Status.Danger}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Border.Glow" Color="{StaticResource Color.Border.Glow}"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/>

    <LinearGradientBrush x:Key="Brush.Gradient.Cyber" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="0.52"/>
        <GradientStop Color="#F472B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Gradient.Panel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#201139" Offset="0"/>
        <GradientStop Color="#111827" Offset="0.55"/>
        <GradientStop Color="#052B3A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Gradient.CardTop" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#C026D3" Offset="0.7"/>
        <GradientStop Color="#F472B6" Offset="1"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="CornerRadius.Card">18</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Button">12</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Modal">20</CornerRadius>
    <CornerRadius x:Key="CornerRadius.Small">10</CornerRadius>

    <DropShadowEffect x:Key="Shadow.Card" Color="#7C3AED" BlurRadius="24" ShadowDepth="0" Opacity="0.22"/>
    <DropShadowEffect x:Key="Shadow.Glow" Color="#22D3EE" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="Background" Value="{StaticResource Brush.Background.Main}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
</ResourceDictionary>
