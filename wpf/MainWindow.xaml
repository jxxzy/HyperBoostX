<Window x:Class="HyperBoostX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scm="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HyperBoostX - Safe AI Windows Gaming Optimizer"
        Height="860"
        Width="1360"
        MinHeight="680"
        MinWidth="980"
        Background="{StaticResource Brush.Background.Main}"
        Foreground="{StaticResource Brush.Text.Primary}"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedNavigationItems" Source="{Binding NavigationItems}">
            <CollectionViewSource.GroupDescriptions>
                <scm:PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Background="{StaticResource Brush.Background.Main}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#090F1B" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource Brush.Gradient.Cyber}" BorderBrush="{StaticResource Brush.Border.Glow}" BorderThickness="1" Margin="0,0,8,0">
                        <TextBlock Text="H" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Black" Foreground="#06111E"/>
                    </Border>
                    <TextBlock Text="HyperBoostX" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="Safe AI Windows Gaming Optimizer" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Muted}" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="-" ToolTip="Minimize" Click="MinimizeButton_Click" Style="{StaticResource CyberGhostButtonStyle}" Width="38" Height="28" Padding="0" Margin="0,0,4,0"/>
                    <Button Content="[]" ToolTip="Maximize or restore" Click="MaximizeRestoreButton_Click" Style="{StaticResource CyberGhostButtonStyle}" Width="38" Height="28" Padding="0" Margin="0,0,4,0"/>
                    <Button Content="X" ToolTip="Close" Click="CloseButton_Click" Style="{StaticResource CyberGhostButtonStyle}" Width="38" Height="28" Padding="0" Background="#2A1420" BorderBrush="#7F1D1D" Foreground="#FCA5A5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="18,18,16,14" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="HyperBoostX" FontSize="22" FontWeight="Black" Foreground="{StaticResource Brush.Accent.Primary}"/>
                        <TextBlock Text="SAFE AI GAMING OPTIMIZER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,6,0,0"/>
                        <Grid Margin="0,14,0,0">
                            <TextBox x:Name="SidebarSearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search visible features"
                                     Height="32"
                                     Padding="10,6"
                                     Background="#121A2A"
                                     BorderBrush="{StaticResource Brush.Border.Subtle}"
                                     Foreground="{StaticResource Brush.Text.Primary}"
                                     CaretBrush="{StaticResource Brush.Accent.Primary}"/>
                            <TextBlock Text="Search tools..."
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SidebarSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,18">
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Button Content="Scan" Style="{StaticResource CyberGhostButtonStyle}" Click="QuickSmartScan_Click" Margin="0,0,6,0"/>
                        <Button Content="Boost" Style="{StaticResource CyberGhostButtonStyle}" Click="QuickSafeBoost_Click" Margin="0,0,6,0"/>
                        <Button Content="Restore" Style="{StaticResource CyberGhostButtonStyle}" Click="QuickRestore_Click"/>
                    </UniformGrid>
                    <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="BackendPulseDot" Width="10" Height="10" Fill="{StaticResource Brush.Status.Warning}" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding BackendBadge}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding BackendStatus}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="Exit" Style="{StaticResource CyberGhostButtonStyle}" Click="ExitButton_Click"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,14,12">
                    <Grid>
                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedNavigationItems}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Padding="2,14,2,6">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SidebarSectionTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CyberSidebarButtonStyle}"
                                        Tag="{Binding ActiveTag}"
                                        CommandParameter="{Binding Key}"
                                        AutomationProperties.Name="{Binding Label}"
                                        AutomationProperties.HelpText="{Binding Group}"
                                        Click="NavButton_Click"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="7" Background="#162033" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="8" Foreground="{StaticResource Brush.Accent.Primary}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Padding="10,28,10,0" IsHitTestVisible="False">
                        <TextBlock Text="No tools found."
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="12"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NavigationItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="92"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#C00B1020" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="28,18,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Black"/>
                        <TextBlock Text="{Binding PageSubtitle}" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,10,0">
                            <TextBlock Text="Safety Guard Active" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding RuntimeMode, StringFormat=Mode: {0}}" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,20,22,0">
                <ContentControl x:Name="PageHost" Focusable="False" Opacity="1">
                    <ContentControl.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>

                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="460">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CyberToastStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
