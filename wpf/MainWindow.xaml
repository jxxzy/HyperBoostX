<Window x:Class="HyperBoostX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperBoostX - Safe AI Windows Gaming Optimizer"
        Height="900"
        Width="1440"
        MinHeight="760"
        MinWidth="1180"
        Background="{StaticResource Brush.Background.Main}"
        Foreground="{StaticResource Brush.Text.Primary}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid Background="{StaticResource Brush.Background.Main}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="22,22,20,18" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="HyperBoostX" FontSize="24" FontWeight="Black" Foreground="{StaticResource Brush.Accent.Primary}"/>
                        <TextBlock Text="SAFE AI GAMING OPTIMIZER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,18">
                    <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="BackendPulseDot" Width="10" Height="10" Fill="{StaticResource Brush.Status.Warning}" RenderTransformOrigin="0.5,0.5" Margin="0,0,10,0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource CyberPulseStoryboard}"/>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding BackendBadge}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="{Binding BackendStatus}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="Exit" Style="{StaticResource CyberGhostButtonStyle}" Click="ExitButton_Click"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,14,14,12">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CyberSidebarButtonStyle}" Tag="{Binding ActiveTag}" CommandParameter="{Binding Key}" Click="NavButton_Click" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="#18243A" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="10" Foreground="{StaticResource Brush.Accent.Primary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Group}" Foreground="{StaticResource Brush.Text.Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="92"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#C00B1020" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="28,18,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Black"/>
                        <TextBlock Text="{Binding PageSubtitle}" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Style="{StaticResource SuccessBadgeStyle}" Margin="0,0,10,0">
                            <TextBlock Text="Safety Guard Active" Foreground="{StaticResource Brush.Status.Success}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentMode, StringFormat=Mode: {0}}" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                        <Border Style="{StaticResource CyberBadgeStyle}">
                            <TextBlock Text="{Binding AccentColor, StringFormat=Accent: {0}}" Foreground="{StaticResource Brush.Text.Secondary}"/>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,0,0">
                <ContentControl x:Name="PageHost" Focusable="False" Opacity="1">
                    <ContentControl.RenderTransform>
                        <TranslateTransform X="0" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>

                <Border Style="{StaticResource CyberToastStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="460">
                    <TextBlock Text="{Binding ToastMessage}" Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
