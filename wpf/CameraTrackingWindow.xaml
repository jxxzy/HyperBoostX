<Window x:Class="HyperBoostX.CameraTrackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HyperBoost X - Real-Time Camera Tracking"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="#020617"
        Foreground="#f8fafc"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="REAL-TIME CAMERA TRACKING" FontSize="18" FontWeight="Bold" Foreground="#38bdf8"/>
                <TextBlock Name="TrackingHeaderText" Text="Motion tracking preview initializing..." FontSize="12" Foreground="#cbd5e1" Margin="0,4,0,0"/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Start" Click="StartTracking_Click" Padding="14,8" Margin="8,0,0,0" Background="#0f766e" Foreground="#f8fafc" BorderBrush="#14b8a6"/>
                <Button Content="Stop" Click="StopTracking_Click" Padding="14,8" Margin="8,0,0,0" Background="#7f1d1d" Foreground="#f8fafc" BorderBrush="#ef4444"/>
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Image Name="CameraPreviewImage" Stretch="Uniform"/>
                <TextBlock Name="CameraPreviewPlaceholderText"
                           Text="Waiting for camera..."
                           Foreground="#94a3b8"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="TrackingStatusText"
                       Grid.Column="0"
                       Text="Status: idle"
                       Foreground="#86efac"
                       FontSize="12"
                       FontFamily="Consolas"
                       LineHeight="17"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>
            <TextBlock Name="TrackingGuideText"
                       Grid.Column="1"
                       Text="The tracker uses frame-difference motion detection and draws a live bounding box around the strongest movement area."
                       Foreground="#cbd5e1"
                       FontSize="12"
                       FontFamily="Consolas"
                       LineHeight="17"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
