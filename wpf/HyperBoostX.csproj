<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>HyperBoostX</AssemblyName>
    <RootNamespace>HyperBoostX</RootNamespace>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\HyperBoostX.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>HyperBoost X</AssemblyTitle>
    <Description>All-in-one Windows optimization, automation, repair, and AI-assisted control center.</Description>
    <Company>MR.4NONY</Company>
    <Authors>MR.4NONY</Authors>
    <Product>HyperBoost X</Product>
    <Copyright>Copyright (c) MR.4NONY</Copyright>
    <Version>1.2.2-dev</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2-dev</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Update="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="temp_obj\**\*.cs" />
    <EmbeddedResource Remove="temp_obj\**\*" />
    <None Remove="temp_obj\**\*" />
    <Page Remove="temp_obj\**\*" />
    <ApplicationDefinition Remove="temp_obj\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="localization\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
