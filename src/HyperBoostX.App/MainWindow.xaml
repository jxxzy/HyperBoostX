<Window x:Class="HyperBoostX.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HyperBoostX.App" Title="HyperBoostX V3 · by NEXORAID" Width="1440" Height="900" MinWidth="1024" MinHeight="600" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="HyperBoostXMain">
 <Window.Resources>
  <DataTemplate x:Key="ExpandedGroupHeader">
   <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="2,6,2,4">
    <TextBlock.Text><MultiBinding StringFormat="{}{0}  {1}"><Binding Path="Name"/><Binding Path="ItemCount"/></MultiBinding></TextBlock.Text>
   </TextBlock>
  </DataTemplate>
  <DataTemplate x:Key="CompactGroupHeader">
   <TextBlock Text="· · ·" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,6"/>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="14,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="38"/>
     <ColumnDefinition Width="220"/>
     <ColumnDefinition Width="*" MinWidth="100" MaxWidth="520"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="☰" Command="{Binding ToggleSidebarCommand}" Padding="8,6" MinHeight="34" AutomationProperties.Name="{Binding Localization[ToggleNavigation]}" AutomationProperties.AutomationId="ToggleSidebarButton"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0">
     <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,9,0">
      <TextBlock Text="N" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock><Run Text="HyperBoost"/><Run Text="X" Foreground="{DynamicResource AccentBrush}"/><Run Text=" V3" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
      <TextBlock Text="by NEXORAID" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
      <TextBlock Text="Unified Full Edition" Foreground="{DynamicResource AccentBrush}" FontSize="9"/>
     </StackPanel>
    </StackPanel>
    <TextBox x:Name="SearchBox" Grid.Column="2" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}" VerticalAlignment="Center" Height="38" Margin="10,0,14,0" ToolTip="{Binding Localization[Search]}" AutomationProperties.Name="{Binding Localization[Search]}" AutomationProperties.AutomationId="SearchFeatures"/>
    <ComboBox x:Name="LanguageSelector" Grid.Column="3" ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" DisplayMemberPath="DisplayName" SelectedValue="{Binding Language,UpdateSourceTrigger=PropertyChanged}" Width="132" Margin="0,0,8,0" AutomationProperties.Name="{Binding Localization[Language]}" AutomationProperties.AutomationId="LanguageSelection"/>
    <ComboBox Grid.Column="4" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Width="112" Margin="0,0,8,0" AutomationProperties.Name="{Binding Localization[UserMode]}"/>
    <ComboBox Grid.Column="5" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="92" Margin="0,0,8,0" AutomationProperties.Name="{Binding Localization[Theme]}" AutomationProperties.AutomationId="ThemeSelection"/>
    <Button Grid.Column="6" Content="◉" Command="{Binding NotificationsCommand}" Padding="10,7" MinHeight="36" ToolTip="{Binding Localization[Notifications]}" AutomationProperties.Name="{Binding Localization[Notifications]}"/>
    <Button Grid.Column="7" Content="?" Command="{Binding HelpCommand}" Padding="10,7" MinHeight="36" ToolTip="{Binding Localization[Help]}" AutomationProperties.Name="{Binding Localization[Help]}"/>
    <Button Grid.Column="8" Content="{Binding Localization[About]}" Command="{Binding AboutCommand}" Padding="12,7" MinHeight="36" ToolTip="{Binding Localization[About]}" AutomationProperties.Name="{Binding Localization[About]}"/>
   </Grid>
  </Border>
  <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel Margin="10,12,10,12">
    <StackPanel DockPanel.Dock="Bottom" Margin="5,12,5,0">
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <StackPanel>
       <TextBlock Text="{Binding SafetyStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" ToolTip="{Binding SafetyDetail}">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding Localization[Safe]}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" ToolTip="{Binding SafetyDetail}">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding SafetyDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="NEXORAID / SYSTEM LAB" Foreground="{DynamicResource TextBrush}" FontSize="10" FontWeight="Bold" Margin="0,13,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="Developed by MR.4NONY · Unified Full Edition" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </Border>
    </StackPanel>
    <ListBox ItemsSource="{Binding NavigationView}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Localization[FeatureNavigation]}" IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}">
     <ListBox.GroupStyle>
      <GroupStyle>
       <GroupStyle.ContainerStyle>
        <Style TargetType="{x:Type GroupItem}">
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="{x:Type GroupItem}">
            <Expander Header="{Binding}" IsExpanded="True" Margin="0,2" Foreground="{DynamicResource MutedBrush}">
             <Expander.Style>
              <Style TargetType="Expander">
               <Setter Property="HeaderTemplate" Value="{StaticResource ExpandedGroupHeader}"/>
               <Setter Property="Background" Value="Transparent"/>
               <Setter Property="BorderThickness" Value="0"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                 <Setter Property="HeaderTemplate" Value="{StaticResource CompactGroupHeader}"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </Expander.Style>
             <ItemsPresenter/>
            </Expander>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </GroupStyle.ContainerStyle>
      </GroupStyle>
     </ListBox.GroupStyle>
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
       <Setter Property="Padding" Value="10,8"/>
       <Setter Property="Margin" Value="0,1"/>
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
       <Setter Property="AutomationProperties.AutomationId" Value="{Binding FeatureId}"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="NavBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="6" Padding="{TemplateBinding Padding}">
           <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger>
           <DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Padding" Value="8,9"/></DataTrigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
       <Setter Property="ContentTemplate">
        <Setter.Value>
         <DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Icon}" Foreground="{DynamicResource BlueBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           <TextBlock x:Name="NavigationLabel" Grid.Column="1" Text="{Binding Name}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding DataContext.SidebarCollapsed,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="NavigationLabel" Property="Visibility" Value="Collapsed"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate>
        </Setter.Value>
       </Setter>
      </Style>
     </ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="26,20,26,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Grid.Row="0" Text="{Binding Breadcrumb}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,0,0,12"/>
   <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" AutomationProperties.AutomationId="CurrentPageTitle"/>
     <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" MaxWidth="760" HorizontalAlignment="Left" Margin="0,5,10,0" FontSize="13"/>
    </StackPanel>
    <Button Grid.Column="1" Content="{Binding Localization[ScanRefresh]}" Command="{Binding ScanCommand}" VerticalAlignment="Top" Margin="10,2,0,0" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold" Visibility="{Binding IsDiagnostic,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="ScanButton"/>
   </Grid>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <Border Visibility="{Binding IsRouteLimited,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,14">
       <StackPanel>
        <DockPanel>
         <TextBlock DockPanel.Dock="Right" Text="{Binding FeatureId}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" AutomationProperties.Name="{Binding Localization[StableFeatureIdentifier]}"/>
         <TextBlock Text="{Binding RouteStatus}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="Bold" AutomationProperties.AutomationId="RouteImplementationStatus"/>
        </DockPanel>
        <TextBlock Text="{Binding RouteDetail}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
        <ItemsControl ItemsSource="{Binding RouteFeatures}" Margin="0,8,0,0">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="0,0,6,5"><TextBlock Text="{Binding}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
     <StackPanel Visibility="{Binding IsDashboard,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
      <Border Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,14">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="{Binding Localization[NexoraidPerformanceSystem]}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
         <TextBlock Text="{Binding Localization[MakeResourcesCount]}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,6"/>
         <TextBlock Text="{Binding Localization[ReadActualState]}" Foreground="{DynamicResource MutedBrush}" MaxWidth="640"/>
         <WrapPanel Margin="0,18,0,0">
          <Button Content="{Binding Localization[RunSmartScan]}" Command="{Binding SmartScanCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
          <Button Content="{Binding Localization[ReviewOptimizations]}" Command="{Binding OptimizeCommand}"/>
          <Button Content="{Binding Localization[RestoreHistory]}" Command="{Binding RestoreCommand}"/>
         </WrapPanel>
        </StackPanel>
        <Border Grid.Column="1" Width="120" Height="120" CornerRadius="60" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="5" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center" Margin="18,0,0,0">
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="N/A" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Localization[Readiness]}" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Localization[NotScored]}" Foreground="{DynamicResource WarningBrush}" FontSize="9" HorizontalAlignment="Center"/>
         </StackPanel>
        </Border>
       </Grid>
      </Border>
      <UniformGrid Columns="4" Margin="0,0,0,14">
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,10,0">
        <StackPanel><TextBlock Text="{Binding Localization[CpuLoad]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding LiveCpu}" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="{Binding Localization[TwoSecondSystemSample]}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
       </Border>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,10,0">
        <StackPanel><TextBlock Text="{Binding Localization[PhysicalMemory]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding LiveMemory}" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,8"/><TextBlock Text="GlobalMemoryStatusEx" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
       </Border>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,10,0">
        <StackPanel><TextBlock Text="{Binding Localization[NetworkTraffic]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding LiveNetwork}" FontSize="17" FontWeight="SemiBold" Margin="0,13,0,10"/><TextBlock Text="{Binding Localization[AggregateActiveInterfaces]}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
       </Border>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="15">
        <StackPanel><TextBlock Text="{Binding Localization[GpuSensors]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Localization[Unavailable]}" FontSize="22" FontWeight="SemiBold" Margin="0,11,0,8"/><TextBlock Text="{Binding Localization[NoValidatedProvider]}" Foreground="{DynamicResource WarningBrush}" FontSize="11"/></StackPanel>
       </Border>
      </UniformGrid>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,4">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
         <TextBlock DockPanel.Dock="Right" Text="{Binding TelemetryStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
         <TextBlock Text="{Binding Localization[SystemTelemetryCpu]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold"/>
        </DockPanel>
        <Grid Grid.Row="1" Height="116" Margin="0,9">
         <Viewbox Stretch="Fill"><Canvas Width="300" Height="100"><Polyline Points="{Binding CpuChart}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/></Canvas></Viewbox>
         <TextBlock Text="{Binding Localization[CollectingCpuSample]}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCpuSamples}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,4,0,0">
         <CheckBox DockPanel.Dock="Right" Content="{Binding Localization[MemoryGuard]}" IsChecked="{Binding MemoryGuardEnabled}" Foreground="{DynamicResource TextBrush}" FontSize="11"/>
         <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
       </Grid>
      </Border>
     </StackPanel>
     <local:IntegrationsPanel Visibility="{Binding IsIntegration,Converter={StaticResource BoolVisibility}}"/>
     <local:TestCenterPanel Visibility="{Binding IsTestCenter,Converter={StaticResource BoolVisibility}}"/>
     <local:GameLibraryPanel Visibility="{Binding IsGameLibrary,Converter={StaticResource BoolVisibility}}"/>
     <local:BenchmarkPanel Visibility="{Binding IsBenchmark,Converter={StaticResource BoolVisibility}}"/>
     <StackPanel Visibility="{Binding IsCleanup,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
      <TextBlock Text="{Binding Localization[CleanupExplanation]}" Margin="0,0,0,12"/>
      <Button Content="{Binding Localization[ScanOldTemporaryFiles]}" Command="{Binding ScanCleanupCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <DataGrid ItemsSource="{Binding CleanupItems}" SelectedItem="{Binding SelectedCleanup}" Height="220" AutomationProperties.Name="{Binding Localization[CleanupCandidates]}"><DataGrid.Columns><DataGridTextColumn Header="Temporary file" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110"/><DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="160"/></DataGrid.Columns></DataGrid>
     </StackPanel>
     <StackPanel Visibility="{Binding IsFileAnalysis,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
       <StackPanel>
        <TextBlock Text="Analisis folder lokal" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Pilih folder yang ingin diperiksa. HyperBoostX membaca metadata dan SHA-256 hanya untuk kandidat berukuran sama. File tidak dipindah, diubah, atau dihapus." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="Pilih folder" Command="{Binding SelectFileAnalysisFolderCommand}" AutomationProperties.AutomationId="SelectFileAnalysisFolderButton" Margin="8,0,0,0"/>
         <TextBox Text="{Binding FileAnalysisRoot,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FileAnalysisRoot"/>
        </DockPanel>
        <WrapPanel Margin="0,10,0,0">
         <TextBlock Text="Batas file besar (MiB)" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/>
         <TextBox Text="{Binding MinimumLargeFileMiB,UpdateSourceTrigger=PropertyChanged}" Width="100" AutomationProperties.AutomationId="LargeFileThreshold"/>
         <Button Content="Mulai analisis" Command="{Binding RunFileAnalysisCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" AutomationProperties.AutomationId="RunFileAnalysisButton"/>
        </WrapPanel>
        <TextBlock Text="{Binding FileAnalysisStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="FileAnalysisStatus"/>
       </StackPanel>
      </Border>
      <TextBlock Text="Grup duplikat terverifikasi" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <DataGrid ItemsSource="{Binding DuplicateGroups}" Height="210" AutomationProperties.AutomationId="DuplicateGroupsGrid" Margin="0,0,0,14"><DataGrid.Columns><DataGridTextColumn Header="Ukuran" Binding="{Binding SizeDisplay}" Width="100"/><DataGridTextColumn Header="Jumlah" Binding="{Binding Files.Count}" Width="80"/><DataGridTextColumn Header="Potensi hemat" Binding="{Binding PotentialDuplicateSizeDisplay}" Width="120"/><DataGridTextColumn Header="Lokasi file" Binding="{Binding PathsDisplay}" Width="*"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="File besar" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <DataGrid ItemsSource="{Binding LargeFiles}" Height="210" AutomationProperties.AutomationId="LargeFilesGrid" Margin="0,0,0,14"><DataGrid.Columns><DataGridTextColumn Header="Ukuran" Binding="{Binding SizeDisplay}" Width="110"/><DataGridTextColumn Header="Terakhir diubah" Binding="{Binding LastWriteTimeDisplay}" Width="180"/><DataGridTextColumn Header="Lokasi" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
      <ItemsControl ItemsSource="{Binding FileAnalysisIssues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding ErrorCode}" ToolTip="{Binding Message}" Foreground="{DynamicResource WarningBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsAppLoadOptimizer,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
       <StackPanel>
        <TextBlock Text="Ukur peluncuran aplikasi" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Pilih executable lokal. Setelah konfirmasi, HyperBoostX meluncurkannya tanpa argumen lalu mengukur pembuatan proses, sinyal GUI siap menerima input (jika tersedia), dan resource awal. Aplikasi tidak ditutup atau diubah." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="Pilih aplikasi" Command="{Binding SelectAppLoadExecutableCommand}" AutomationProperties.AutomationId="SelectAppLoadExecutableButton" Margin="8,0,0,0"/>
         <TextBox Text="{Binding AppLoadExecutable,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AppLoadExecutable"/>
        </DockPanel>
        <Button Content="Mulai pengukuran" Command="{Binding MeasureAppLoadCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.AutomationId="MeasureAppLoadButton"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <Border Visibility="{Binding IsLcdGuard,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="LCD utility monitor policy" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="Set alert thresholds, then use Scan. HyperBoostX only measures known utility processes; it never stops cooling, fan, pump, security, or vendor-control software." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
       <WrapPanel><TextBlock Text="CPU threshold (%)" VerticalAlignment="Center"/><TextBox Text="{Binding LcdCpuThreshold,UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.AutomationId="LcdCpuThreshold"/><TextBlock Text="Memory threshold (MiB)" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox Text="{Binding LcdMemoryThresholdMiB,UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.AutomationId="LcdMemoryThreshold"/><CheckBox Content="Alert only during HyperBoostX gaming sessions" IsChecked="{Binding LcdGamingOnly}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="LcdGamingOnly"/></WrapPanel>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16" Visibility="{Binding HasActions,Converter={StaticResource BoolVisibility}}">
      <StackPanel>
       <TextBlock Text="{Binding Localization[ControlledChanges]}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,0,12"/>
       <WrapPanel><ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="Name" Width="290" AutomationProperties.Name="{Binding Localization[SelectAction]}"/><Button Content="{Binding Localization[PreviewApply]}" Command="{Binding ApplyCommand}" AutomationProperties.AutomationId="PreviewAction"/></WrapPanel>
       <TextBlock Text="{Binding ActionDescription}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,8"/>
       <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Visibility="{Binding IsPower,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Localization[PowerPlan]}" HorizontalAlignment="Left" Width="340"/>
       <ComboBox ItemsSource="{Binding StartupItems}" SelectedItem="{Binding SelectedStartup}" Visibility="{Binding IsStartup,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Localization[StartupTarget]}" HorizontalAlignment="Left" Width="340"/>
      </StackPanel>
     </Border>
     <WrapPanel Margin="0,0,0,16" Visibility="{Binding IsNetwork,Converter={StaticResource BoolVisibility}}"><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}" Width="230" Margin="0,0,10,0" AutomationProperties.Name="{Binding Localization[HostOrIp]}" AutomationProperties.AutomationId="NetworkTestHost"/><Button Content="{Binding Localization[MeasurePing]}" Command="{Binding PingCommand}"/><Button Content="{Binding Localization[ResolveDns]}" Command="{Binding ResolveDnsCommand}" AutomationProperties.AutomationId="ResolveDnsButton"/></WrapPanel>
     <Border Visibility="{Binding HasFindings,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
      <StackPanel><TextBlock Text="{Binding Localization[FindingsRecommendations]}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><ItemsControl ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,14,0,4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/><TextBlock Text="{Binding Recommendation}"/><TextBlock Text="{Binding Confidence}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     </Border>
     <StackPanel Visibility="{Binding IsRestore,Converter={StaticResource BoolVisibility}}">
      <WrapPanel Margin="0,0,0,14"><Button Content="{Binding Localization[VerifyCurrentState]}" Command="{Binding VerifyCommand}"/><Button Content="{Binding Localization[RestoreSelected]}" Command="{Binding RollbackCommand}"/></WrapPanel>
      <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedChange}" Height="340" AutomationProperties.Name="{Binding Localization[ChangeHistory]}"><DataGrid.Columns><DataGridTextColumn Header="{Binding Localization[Action]}" Binding="{Binding ActionId}" Width="*"/><DataGridTextColumn Header="{Binding Localization[Status]}" Binding="{Binding Status}" Width="155"/><DataGridTextColumn Header="{Binding Localization[Started]}" Binding="{Binding StartedAt,StringFormat=yyyy-MM-dd HH:mm}" Width="160"/></DataGrid.Columns></DataGrid>
      <TextBlock Text="{Binding Localization[NoHistoryEntries]}" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,16"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSettings,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding Localization[Language]}" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Code" DisplayMemberPath="DisplayName" SelectedValue="{Binding Language,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="280"/><TextBlock Text="{Binding Localization[CoverageNotice]}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding Localization[Appearance]}" FontWeight="SemiBold" Margin="0,18,0,8"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Left" Width="280"/>
      <TextBlock Text="{Binding Localization[YourGoal]}" FontWeight="SemiBold" Margin="0,18,0,8"/><ComboBox ItemsSource="{Binding Goals}" SelectedItem="{Binding Goal}" HorizontalAlignment="Left" Width="280"/>
      <TextBlock Text="{Binding Localization[DetailLevelSafety]}" FontWeight="SemiBold" Margin="0,18,0,8"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Left" Width="280"/>
      <TextBlock Text="{Binding Localization[Privacy]}" FontSize="20" Margin="0,24,0,10"/><TextBlock Text="{Binding Localization[LocalDiagnosticsOnly]}" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="{Binding DataLocation}" Margin="0,12,0,16"/><Button Content="{Binding Localization[BackupDatabase]}" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding Localization[SettingsDataScope]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,8"/>
      <WrapPanel Margin="0,0,0,12">
       <Button Content="{Binding Localization[ExportSettings]}" Command="{Binding ExportSettingsCommand}" AutomationProperties.AutomationId="ExportSettingsButton"/>
       <Button Content="{Binding Localization[ImportSettings]}" Command="{Binding ImportSettingsCommand}" AutomationProperties.AutomationId="ImportSettingsButton"/>
       <Button Content="{Binding Localization[ResetPreferences]}" Command="{Binding ResetSettingsCommand}" AutomationProperties.AutomationId="ResetSettingsButton"/>
      </WrapPanel>
      <TextBlock Text="{Binding Localization[BuildInfo]}" Foreground="{DynamicResource MutedBrush}" Margin="0,24,0,0"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsReports,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding Localization[LocalReports]}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Localization[SupportBundleConsent]}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,20"/>
      <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{Binding Localization[SavedReports]}" Margin="0,0,0,12"/>
      <WrapPanel><Button Content="{Binding Localization[ExportSelectedReport]}" Command="{Binding ExportCommand}"/><Button Content="{Binding Localization[CreateSupportZip]}" Command="{Binding SupportCommand}"/></WrapPanel>
      <TextBlock Text="{Binding ObservationSummary}" Margin="0,20,0,0" Foreground="{DynamicResource MutedBrush}"/>
     </StackPanel>
     <Border Visibility="{Binding HasTools,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
      <StackPanel><TextBlock Text="{Binding Localization[WindowsTools]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/><WrapPanel><ComboBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedHandoff}" Width="300" AutomationProperties.Name="{Binding Localization[WindowsTools]}"/><Button Content="{Binding Localization[OpenWindowsTool]}" Command="{Binding OpenToolCommand}"/></WrapPanel></StackPanel>
     </Border>
     <StackPanel Visibility="{Binding HasFacts,Converter={StaticResource BoolVisibility}}">
      <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="{Binding Localization[Export]}" Command="{Binding ExportCommand}" Padding="12,5" MinHeight="30"/><TextBlock DockPanel.Dock="Right" Text="{Binding Localization[Search]}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox DockPanel.Dock="Right" Text="{Binding FactFilter,UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" ToolTip="{Binding Localization[Search]}" AutomationProperties.Name="{Binding Localization[Search]}" AutomationProperties.AutomationId="ObservationFilter"/><TextBlock Text="{Binding Localization[Observations]}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
      <DataGrid ItemsSource="{Binding FactsView}" SelectedItem="{Binding SelectedFact,Mode=TwoWay}" Height="340" AutomationProperties.Name="{Binding Localization[Observations]}" AutomationProperties.AutomationId="ObservationFacts"><DataGrid.Columns><DataGridTextColumn Header="{Binding Localization[Observation]}" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="{Binding Localization[Value]}" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="{Binding Localization[Evidence]}" Binding="{Binding Quality}" Width="100"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip"><Setter.Value><TextBlock Text="{Binding Source}" MaxWidth="600"/></Setter.Value></Setter></Style></DataGrid.RowStyle></DataGrid>
      <Border Visibility="{Binding HasFactDetails,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"><TextBlock Text="{Binding FactDetails}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="{Binding FactDetails}" AutomationProperties.AutomationId="FactDetailsText"/></Border>
      <TextBlock Text="{Binding ObservationSummary}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
     </StackPanel>
     <TextBox Text="{Binding Detail,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Visibility="{Binding HasDetail,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Localization[OperationDetails]}"/>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="{Binding Localization[Cancel]}" Command="{Binding CancelCommand}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" Padding="12,5" MinHeight="30"/>
     <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" AutomationProperties.AutomationId="OperationStatus"/>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
