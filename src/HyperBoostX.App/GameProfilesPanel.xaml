<UserControl x:Class="HyperBoostX.App.GameProfilesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel AutomationProperties.AutomationId="PerGameProfilesPanel">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,12">
   <TextBlock Text="{Binding Localization[GameProfileScopeNotice]}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
  </Border>
  <TabControl Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="GameProfileTabs">
   <TabControl.Resources>
    <Style TargetType="TabItem">
     <Setter Property="Padding" Value="14,8"/>
     <Setter Property="Margin" Value="0,0,5,0"/>
     <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
     <Setter Property="Background" Value="Transparent"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/></Trigger>
     </Style.Triggers>
    </Style>
   </TabControl.Resources>
   <TabItem Header="{Binding Localization[Workspace]}" AutomationProperties.AutomationId="GameProfilesWorkspaceTab">
     <StackPanel Margin="4,12,4,4">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,8,0">
        <StackPanel>
         <TextBlock Text="{Binding Localization[GameProfileCapabilityWorkspaceTitle]}" FontSize="16" FontWeight="SemiBold" AutomationProperties.AutomationId="GameProfileCapabilityWorkspaceTitle"/>
         <UniformGrid Columns="3" Margin="0,8,0,0" AutomationProperties.AutomationId="GameProfileCapabilityGrid">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
           <StackPanel>
            <TextBlock Text="{Binding Localization[UnavailableStatus]}" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[GameProfileAutoApplyTitle]}" FontWeight="SemiBold" Margin="0,4,0,2" AutomationProperties.AutomationId="GameProfileAutoApplyTitle"/>
            <TextBlock Text="{Binding Localization[GameProfileAutoApplyUnavailable]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" AutomationProperties.AutomationId="GameProfileAutoApplyStatus"/>
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
           <StackPanel>
            <TextBlock Text="{Binding Localization[LimitedStatus]}" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[GameProfileAutoRestoreTitle]}" FontWeight="SemiBold" Margin="0,4,0,2" AutomationProperties.AutomationId="GameProfileAutoRestoreTitle"/>
            <TextBlock Text="{Binding Localization[GameProfileAutoRestoreDetail]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" AutomationProperties.AutomationId="GameProfileAutoRestoreStatus"/>
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
           <StackPanel>
            <TextBlock Text="{Binding Localization[ImplementedStatus]}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[GameProfileEditor]}" FontWeight="SemiBold" Margin="0,4,0,2" AutomationProperties.AutomationId="GameProfileCapabilityEditorTitle"/>
            <TextBlock Text="{Binding Localization[GameProfileCapabilityEditorDetail]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
           <StackPanel>
            <TextBlock Text="{Binding Localization[ImplementedStatus]}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[GameProfileImport]}" FontWeight="SemiBold" Margin="0,4,0,2" AutomationProperties.AutomationId="GameProfileCapabilityImportTitle"/>
            <TextBlock Text="{Binding Localization[GameProfileCapabilityImportDetail]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
           <StackPanel>
            <TextBlock Text="{Binding Localization[ImplementedStatus]}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[GameProfileExport]}" FontWeight="SemiBold" Margin="0,4,0,2" AutomationProperties.AutomationId="GameProfileCapabilityExportTitle"/>
            <TextBlock Text="{Binding Localization[GameProfileExportNotice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
           </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="3">
           <StackPanel>
            <TextBlock Text="{Binding Localization[ImplementedStatus]}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="{Binding Localization[GameProfileHistoryTitle]}" FontWeight="SemiBold" Margin="0,4,0,2" AutomationProperties.AutomationId="GameProfileCapabilityHistoryTitle"/>
            <TextBlock Text="{Binding Localization[GameProfileCapabilityHistoryDetail]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
           </StackPanel>
          </Border>
         </UniformGrid>
        </StackPanel>
       </Border>
       <StackPanel Grid.Column="1">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
         <StackPanel>
          <DockPanel>
           <TextBlock Text="{Binding SafetyStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
           <TextBlock Text="{Binding Localization[GameProfileSafetyTitle]}" FontSize="15" FontWeight="SemiBold" AutomationProperties.AutomationId="GameProfileActionSafetyTitle"/>
          </DockPanel>
          <TextBlock Text="{Binding SafetyDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Localization[GameProfileSafetyDetail]}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
         </StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,8,0,0">
         <StackPanel>
          <TextBlock Text="{Binding Localization[GameProfileModuleContractTitle]}" FontSize="15" FontWeight="SemiBold" AutomationProperties.AutomationId="GameProfileModuleContractTitle"/>
          <DockPanel Margin="0,6,0,0">
           <TextBlock Text="{Binding FeatureId}" Foreground="{DynamicResource MutedBrush}" FontSize="9" DockPanel.Dock="Right"/>
           <TextBlock Text="{Binding RouteStatus}" Foreground="{DynamicResource WarningBrush}" FontSize="9" FontWeight="Bold"/>
          </DockPanel>
          <TextBlock Text="{Binding RouteDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
          <TextBlock Text="{Binding Localization[GameProfileApprovalNotice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </Grid>
      <Grid Margin="0,10,0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
      <StackPanel>
       <TextBlock Text="{Binding Localization[GameProfileLibrary]}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Localization[GameProfileLibraryDetail]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
       <WrapPanel>
        <Button Content="{Binding Localization[GameProfileRegisterGame]}" Command="{Binding AddGameCommand}" AutomationProperties.AutomationId="RegisterGameProfileButton"/>
        <Button Content="{Binding Localization[GameProfileDiscover]}" Command="{Binding DiscoverGamesCommand}" AutomationProperties.AutomationId="DiscoverGameProfilesButton"/>
        <Button Content="{Binding Localization[GameProfileImport]}" Command="{Binding ImportGamesCommand}" AutomationProperties.AutomationId="ImportGameProfilesButton"/>
        <Button Content="{Binding Localization[GameProfileExport]}" Command="{Binding ExportGamesCommand}" AutomationProperties.AutomationId="ExportGameProfilesButton"/>
        <Button Content="{Binding Localization[GameProfileRemove]}" Command="{Binding RemoveGameCommand}" AutomationProperties.AutomationId="RemoveGameProfileButton"/>
       </WrapPanel>
       <Grid Margin="0,8,0,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding DiscoveredGames}" SelectedItem="{Binding SelectedDiscoveredGame,Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="{Binding Localization[GameProfileDiscover]}" AutomationProperties.AutomationId="DiscoveredGameProfileList"/>
        <Button Grid.Column="1" Content="{Binding Localization[GameProfileAddDiscovered]}" Command="{Binding RegisterDiscoveredGameCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="RegisterDiscoveredGameButton"/>
       </Grid>
       <Grid MinHeight="130" MaxHeight="220" Margin="0,8,0,8">
        <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame,Mode=TwoWay}" DisplayMemberPath="Name" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" MinHeight="130" MaxHeight="220" AutomationProperties.Name="{Binding Localization[GameProfileLibrary]}" AutomationProperties.AutomationId="GameProfileLibraryList">
         <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasRegisteredGames}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
        </ListBox>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" MinHeight="130" AutomationProperties.AutomationId="GameProfileEmptyState">
         <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRegisteredGames}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
         <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
          <TextBlock Text="{Binding Localization[GameProfileNoGames]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="GameProfileEmptyStateMessage"/>
          <Button Content="{Binding Localization[GameProfileRegisterGame]}" Command="{Binding AddGameCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" AutomationProperties.AutomationId="GameProfileEmptyStateRegisterButton"/>
         </StackPanel>
        </Border>
       </Grid>
       <TextBlock Text="{Binding Localization[GameProfileIdentityLabel]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,5,0,3"/>
       <TextBlock Text="{Binding SelectedGame.Executable}" TextWrapping="Wrap" AutomationProperties.AutomationId="SelectedGameProfileExecutable"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
      <StackPanel IsEnabled="{Binding HasRegisteredGames}">
       <TextBlock Text="{Binding Localization[GameProfileEditor]}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Localization[GameProfileNamePolicy]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
       <TextBlock Text="{Binding Localization[GameProfilePowerPolicy]}" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
       <CheckBox Content="{Binding Localization[GameProfileUsePowerPlan]}" IsChecked="{Binding ProfileUsePowerPlan}" Foreground="{DynamicResource TextBrush}" Margin="0,6"/>
       <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" IsEnabled="{Binding ProfileUsePowerPlan}" AutomationProperties.Name="{Binding Localization[GameProfilePowerPolicy]}" AutomationProperties.AutomationId="GameProfilePowerPlan"/>
       <CheckBox Content="{Binding Localization[GameProfileDisableCapture]}" IsChecked="{Binding ProfileDisableCapture}" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,5"/>
       <CheckBox Content="{Binding Localization[GameProfileDisableTransparency]}" IsChecked="{Binding ProfileDisableTransparency}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
       <CheckBox IsChecked="{Binding ProfileRaisePriority}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"><TextBlock Text="{Binding Localization[GameProfileRaisePriority]}" TextWrapping="Wrap"/></CheckBox>
       <TextBlock Text="{Binding Localization[GameProfileApprovalNotice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <WrapPanel>
        <Button Content="{Binding Localization[GameProfileSave]}" Command="{Binding SaveGameProfileCommand}" AutomationProperties.AutomationId="SaveGameProfileButton"/>
        <Button Content="{Binding Localization[GameProfilePreviewLaunch]}" Command="{Binding StartGameCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" AutomationProperties.AutomationId="PreviewLaunchGameButton"/>
        <Button Content="{Binding Localization[GameProfileRestore]}" Command="{Binding RestoreGameCommand}" AutomationProperties.AutomationId="RestoreGameProfileSessionButton"/>
       </WrapPanel>
       <TextBlock Text="{Binding GamingSessionStatus}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="GameProfileSessionStatus"/>
      </StackPanel>
     </Border>
    </Grid>
   </StackPanel>
   </TabItem>
   <TabItem Header="{Binding Localization[Evidence]}" AutomationProperties.AutomationId="GameProfilesEvidenceTab">
    <Grid Margin="4,12,4,4">
     <StackPanel Visibility="{Binding HasFacts,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding Localization[GameProfileEvidenceTitle]}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <DataGrid ItemsSource="{Binding FactsView}" SelectedItem="{Binding SelectedFact,Mode=TwoWay}" Height="330" AutomationProperties.Name="{Binding Localization[GameProfileEvidenceTitle]}" AutomationProperties.AutomationId="GameProfileEvidenceGrid">
       <DataGrid.Columns><DataGridTextColumn Header="{Binding Localization[Name]}" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="{Binding Localization[Value]}" Binding="{Binding Value}" Width="2*"/><DataGridTextColumn Header="{Binding Localization[Source]}" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="{Binding Localization[Availability]}" Binding="{Binding Availability}" Width="*"/></DataGrid.Columns>
      </DataGrid>
     </StackPanel>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasFacts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding Localization[GameProfileNoEvidence]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>
      <Button Content="{Binding Localization[GameProfileScan]}" Command="{Binding ScanGamesCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" AutomationProperties.AutomationId="ScanSavedGamesButton"/>
     </StackPanel>
    </Grid>
   </TabItem>
   <TabItem Header="{Binding Localization[SmartScanHistoryTab]}" AutomationProperties.AutomationId="GameProfilesHistoryTab">
    <Grid Margin="4,12,4,4">
     <DataGrid ItemsSource="{Binding GameProfileHistory}" SelectedItem="{Binding SelectedChange,Mode=TwoWay}" Height="330" Visibility="{Binding HasGameProfileHistory,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Localization[GameProfileHistoryTitle]}" AutomationProperties.AutomationId="GameProfileHistoryGrid">
      <DataGrid.Columns><DataGridTextColumn Header="{Binding Localization[GameProfileHistoryTitle]}" Binding="{Binding ActionId}" Width="2*"/><DataGridTextColumn Header="{Binding Localization[Status]}" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="{Binding Localization[Target]}" Binding="{Binding Target}" Width="2*"/><DataGridTextColumn Header="{Binding Localization[DesiredState]}" Binding="{Binding Desired}" Width="*"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="{Binding Localization[GameProfileHistoryEmpty]}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGameProfileHistory}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </TabItem>
   <TabItem Header="{Binding Localization[Help]}" AutomationProperties.AutomationId="GameProfilesHelpTab">
    <StackPanel Margin="10,14">
     <TextBlock Text="{Binding Localization[GameProfileSafetyTitle]}" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding RouteDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding Localization[GameProfileSafetyDetail]}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding Localization[GameProfileExportNotice]}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </TabItem>
  </TabControl>
 </StackPanel>
</UserControl>
