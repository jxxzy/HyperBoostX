<UserControl x:Class="HyperBoostX.App.BenchmarkPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="BENCHMARK LAB" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
  <Border Visibility="{Binding IsStutterAnalyzer,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,10">
   <StackPanel><TextBlock Text="Frametime capture analysis" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Import a CSV containing frametime_ms and optional cpu, gpu, disk_io, and temperature columns. HyperBoostX calculates FPS lows, percentiles, spikes, and correlations; it does not claim this is a live capture." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10"/><Button Content="Import frametime CSV" Command="{Binding ImportFrametimeCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportFrametimeButton"/></StackPanel>
  </Border>
  <Border Visibility="{Binding IsResearchMode,Converter={StaticResource BoolVisibility}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,10">
   <StackPanel>
    <TextBlock Text="A/B/C/D repeat trials" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Record only measurements you actually performed. Variant A is the comparison baseline; HyperBoostX does not simulate SSD/RAM upgrades or infer causation." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10"/>
    <WrapPanel><TextBlock Text="Experiment" VerticalAlignment="Center"/><TextBox Text="{Binding ResearchExperiment,UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.AutomationId="ResearchExperiment"/><TextBlock Text="Workload" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox Text="{Binding ResearchWorkload,UpdateSourceTrigger=PropertyChanged}" Width="150" AutomationProperties.AutomationId="ResearchWorkload"/><TextBlock Text="Variant" VerticalAlignment="Center" Margin="8,0,0,0"/><ComboBox ItemsSource="{Binding ResearchVariants}" SelectedItem="{Binding ResearchVariant}" Width="60" AutomationProperties.AutomationId="ResearchVariant"/></WrapPanel>
    <WrapPanel Margin="0,8,0,0"><TextBlock Text="Metric" VerticalAlignment="Center"/><TextBox Text="{Binding ResearchMetric,UpdateSourceTrigger=PropertyChanged}" Width="130" AutomationProperties.AutomationId="ResearchMetric"/><TextBlock Text="Value" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox Text="{Binding ResearchValue,UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.AutomationId="ResearchValue"/><TextBlock Text="Unit" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBox Text="{Binding ResearchUnit,UpdateSourceTrigger=PropertyChanged}" Width="80" AutomationProperties.AutomationId="ResearchUnit"/></WrapPanel>
    <TextBox Text="{Binding ResearchNotes,UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" ToolTip="Trial notes"/><WrapPanel><Button Content="Save trial" Command="{Binding AddResearchTrialCommand}" AutomationProperties.AutomationId="SaveResearchTrialButton"/><Button Content="Analyze experiment" Command="{Binding AnalyzeResearchCommand}" AutomationProperties.AutomationId="AnalyzeResearchButton"/></WrapPanel>
    <ListBox ItemsSource="{Binding ResearchHistory}" MaxHeight="150" Margin="0,8,0,0" AutomationProperties.AutomationId="ResearchHistory"/>
   </StackPanel>
  </Border>
  <WrapPanel Margin="0,12"><Button Content="Run CPU benchmark · 3 seconds" Command="{Binding CpuBenchmarkCommand}"/><Button Content="Run storage benchmark · 64 MiB" Command="{Binding StorageBenchmarkCommand}"/></WrapPanel>
  <TextBlock Text="Tes lokal mengukur throughput SHA-256 atau I/O file. Hasil tersimpan di Reports dan tidak dikonversi menjadi skor FPS." Foreground="{DynamicResource MutedBrush}"/>
  <TextBlock Text="Catat hasil capture Anda atau impor CSV. Angka diberi label User Reported; aplikasi tidak mengarang FPS atau mengklaim pengukuran GPU otomatis." Margin="0,10,0,15"/>
  <Grid IsEnabled="{Binding Busy,Converter={StaticResource InverseBool}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Game / workload"/><TextBox Text="{Binding BenchmarkGame,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Benchmark game" Margin="0,5,0,12"/><TextBlock Text="Average FPS"/><TextBox Text="{Binding BenchmarkAverage,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Average FPS" Margin="0,5,0,12"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="1% low FPS"/><TextBox Text="{Binding BenchmarkLow,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="1% low FPS" Margin="0,5,0,12"/><TextBlock Text="Average frametime (ms)"/><TextBox Text="{Binding BenchmarkFrametime,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Average frametime" Margin="0,5,0,12"/></StackPanel>
  </Grid>
  <TextBlock Text="Notes: resolution, settings, capture tool, workload"/><TextBox Text="{Binding BenchmarkNotes,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
  <WrapPanel Margin="0,0,0,12"><Button Content="Save benchmark" Command="{Binding AddBenchmarkCommand}"/><Button Content="Import CSV" Command="{Binding ImportBenchmarkCommand}"/></WrapPanel>
  <TextBlock Text="CSV: game,avg_fps,one_percent_low_fps,average_frametime_ms,notes (decimal point; max 200 rows). Import is validated completely before saving." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
  <TextBlock Text="Selected result"/><ComboBox ItemsSource="{Binding BenchmarkHistory}" SelectedItem="{Binding SelectedBenchmark}" AutomationProperties.Name="Benchmark results" Margin="0,5,0,12"/>
  <TextBlock Text="Baseline for comparison"/><ComboBox ItemsSource="{Binding BenchmarkHistory}" SelectedItem="{Binding BaselineBenchmark}" AutomationProperties.Name="Benchmark baseline" Margin="0,5,0,12"/>
  <Button Content="Compare selected with baseline" Command="{Binding CompareBenchmarksCommand}" HorizontalAlignment="Left" Margin="0,0,0,20"/>
 </StackPanel>
</UserControl>
